---
interface Props {
	title?: string;
	description?: string;
	path?: string;
	ogImage?: string;
	ogType?: string;
	jsonLd?: string;
}

const {
	title = "Arnold Gamboa",
	description = "Software engineering leader, builder, and pastor. Bridging faith and technology from Pasig City, Philippines.",
	path = "/",
	ogImage = "/images/og-default-v2.png",
	ogType = "website",
	jsonLd = "",
} = Astro.props;

const site = "https://arnold.gamboa.ph";
const fullTitle =
	title === "Arnold Gamboa" ? "Arnold Gamboa — Shipped & Unfinished" : `${title} — Arnold Gamboa`;
const pageUrl = `${site}${path === "/" ? "" : path}`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${site}${ogImage}`;

const nav = [
	{ href: "/", label: "Home", match: "/" },
	{ href: "/blog/", label: "Blog", match: "/blog" },
	{ href: "/now/", label: "Now", match: "/now" },
	{ href: "/contact/", label: "Contact", match: "/contact" },
	{ href: "https://youpastor.com", label: "YouPastor", external: true },
] as const;

function isCurrent(match: string) {
	if (match === "/") return path === "/";
	return path === match || path.startsWith(`${match}/`);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f3efe6" />
		<link rel="canonical" href={pageUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<link rel="alternate" type="application/rss+xml" title="Shipped &amp; Unfinished" href={`${site}/feed.xml`} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Arnold Gamboa — software engineering leader, builder, and pastor" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="Shipped &amp; Unfinished" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Arnold Gamboa — software engineering leader, builder, and pastor" />
		<title>{fullTitle}</title>
		<!-- JSON-LD -->
		{jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
		<style is:global>
			@import "../styles/global.css";
		</style>
	</head>
	<body>
		<!--
			THESIS: Arnold arrives as a speaker one-sheet — portrait plate, plain through-line, role coupons, contact as booking strip — not a consultancy hero or dark blog skin.
			OWN-WORLD: Matte press-kit paper (#F3EFE6), near-black ink, slate tabs (#1F3D4A), stamp-red contact (#B84A2E), hairline rules, photo plate with soft offset shadow; Archivo grotesk throughout.
			STORY: Visitor recognizes Arnold (eng leader who builds + pastor bridging faith & tech), can contact/follow immediately, then sees current focus (YouPastor/Now) and paths to writing.
			FIRST VIEWPORT: Kit-tab nav; large portrait plate left (top on mobile); name + through-line; slate booking strip with socials + email CTA; three role coupons; Now cue below fold on short screens.
			FORM: Speaker One-Sheet (grounded #3) · seed d62a4abb · mode persuade
			FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
		-->
		<div class="site-shell">
			<header class="kit-header">
				<a class="kit-mark" href="/">
					<span class="kit-mark__name">Arnold Gamboa</span>
					<span class="kit-mark__title">Shipped &amp; Unfinished</span>
				</a>
				<nav aria-label="Primary">
					<ul class="kit-tabs">
						{
							nav.map((item) => (
								<li>
									{"external" in item && item.external ? (
										<a
											class="kit-tabs__external"
											href={item.href}
											target="_blank"
											rel="noopener noreferrer"
										>
											{item.label}
										</a>
									) : (
										<a
											href={item.href}
											aria-current={isCurrent(item.match) ? "page" : undefined}
										>
											{item.label}
										</a>
									)}
								</li>
							))
						}
					</ul>
				</nav>
			</header>

			<main>
				<slot />
			</main>

			<footer class="site-footer">
				<span>Pasig City, Philippines</span>
				<span>
					<a href="mailto:arnold@gamboa.ph">arnold@gamboa.ph</a>
				</span>
			</footer>
		</div>
	</body>
</html>
