---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.data.slug },
		props: { post },
	}));
}) satisfies GetStaticPaths;

interface Props {
	post: {
		id: string;
		data: {
			title: string;
			description: string;
			pubDate: Date;
			slug: string;
			heroImage?: string;
			heroAlt?: string;
			tags: string[];
		};
	};
}

const { post } = Astro.props;
const { Content } = await render(post);
const postDate = post.data.pubDate.toLocaleDateString("en-GB", {
	day: "2-digit",
	month: "short",
	year: "numeric",
});
const isoDate = post.data.pubDate.toISOString();

// page-specific og image: heroImage or og-default.png landscape fallback
const ogImage = post.data.heroImage || "/images/og-default.png";

// JSON-LD BlogPosting + BreadcrumbList
const jsonLd = JSON.stringify([
	{
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		"@id": `https://arnold.gamboa.ph/${post.data.slug}/#article`,
		headline: post.data.title,
		description: post.data.description,
		datePublished: post.data.pubDate.toISOString(),
		author: {
			"@type": "Person",
			name: "Arnold Gamboa",
			url: "https://arnold.gamboa.ph",
		},
		publisher: {
			"@type": "Person",
			name: "Arnold Gamboa",
			url: "https://arnold.gamboa.ph",
		},
		image: post.data.heroImage || "https://arnold.gamboa.ph/images/og-default.png",
		mainEntityOfPage: {
			"@type": "WebPage",
			"@id": `https://arnold.gamboa.ph/${post.data.slug}/`,
		},
		...(post.data.tags.length > 0 && {
			keywords: post.data.tags.join(", "),
		}),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: "https://arnold.gamboa.ph",
			},
			{
				"@type": "ListItem",
				position: 2,
				name: "Blog",
				item: "https://arnold.gamboa.ph/blog/",
			},
		],
	},
]);

// related posts
const allPosts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = allPosts
	.filter((p) => p.data.slug !== post.data.slug)
	.map((p) => ({ post: p, overlap: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
	.filter((r) => r.overlap > 0)
	.sort((a, b) => b.overlap - a.overlap || b.post.data.pubDate - a.post.data.pubDate)
	.slice(0, 3)
	.map((r) => r.post);

// previous / next by date
const idx = allPosts.findIndex((p) => p.data.slug === post.data.slug);
const prevPost = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
const nextPost = idx > 0 ? allPosts[idx - 1] : null;
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	path={`/${post.data.slug}/`}
	ogImage={ogImage}
	ogType="article"
	jsonLd={jsonLd}
>
	<article class="post-page">
		<header class="post-head">
			<nav class="post-meta" aria-label="Breadcrumb">
				<a href="/blog/" class="post-meta__back">← Blog</a>
				<span class="post-meta__date">
					<time datetime={isoDate}>{postDate}</time>
				</span>
			</nav>
			<h1>{post.data.title}</h1>
			{
				post.data.tags.length > 0 && (
					<ul class="post-tags">
						{post.data.tags.map((tag) => (
							<li>
								<a href={`/blog/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
							</li>
						))}
					</ul>
				)
			}
		</header>

		{
			post.data.heroImage && (
				<figure class="post-hero">
					<img
						src={post.data.heroImage}
						alt={post.data.heroAlt || post.data.title}
						width="1200"
						height="675"
						loading="eager"
					/>
				</figure>
			)
		}

		<div class="post-body">
			<Content />
		</div>

		<footer class="post-foot">
			<nav class="post-nav" aria-label="Article navigation">
				{
					prevPost && (
						<a class="post-nav__prev" href={`/${prevPost.data.slug}/`}>
							<span class="post-nav__label">Newer</span>
							{prevPost.data.title}
						</a>
					)
				}
				{
					nextPost && (
						<a class="post-nav__next" href={`/${nextPost.data.slug}/`}>
							<span class="post-nav__label">Older</span>
							{nextPost.data.title}
						</a>
					)
				}
			</nav>

			{
				related.length > 0 && (
					<nav class="related" aria-label="Related posts">
						<h2>Related</h2>
						<ul>
							{related.map((p) => (
								<li>
									<a href={`/${p.data.slug}/`}>{p.data.title}</a>
									<span>{p.data.pubDate.toLocaleDateString("en-GB", { year: "numeric" })}</span>
								</li>
							))}
						</ul>
					</nav>
				)
			}
			<a class="post-back-link" href="/blog/">All posts →</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.post-page {
		max-width: 46rem;
	}

	.post-head {
		margin-bottom: 2rem;
	}

	.post-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 1.25rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid color-mix(in srgb, var(--rule) 40%, transparent);
		font-size: var(--text-xs);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--rule);
	}

	.post-meta__back {
		color: var(--tab);
		font-weight: 700;
		text-decoration: none;
	}

	.post-meta__back:hover {
		color: var(--stamp);
	}

	.post-head h1 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 4.2vw, 2.9rem);
		line-height: 1.12;
		letter-spacing: -0.03em;
		font-weight: 700;
		text-wrap: balance;
		color: var(--ink);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-tags a {
		display: inline-block;
		padding: 0.2rem 0.6rem;
		border: 1px solid color-mix(in srgb, var(--rule) 40%, transparent);
		border-radius: 2px;
		background: color-mix(in srgb, var(--paper-deep) 60%, white);
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--ink-soft);
		text-decoration: none;
	}

	.post-tags a:hover {
		border-color: var(--stamp);
		color: var(--stamp);
	}

	.post-hero {
		margin: 0 0 2rem;
		background: var(--paper-deep);
		border: 1px solid color-mix(in srgb, var(--rule) 35%, transparent);
		box-shadow: var(--plate-shadow);
	}

	.post-hero img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		display: block;
	}

	.post-body {
		line-height: 1.72;
		font-size: var(--text-base);
		color: var(--ink);
	}

	.post-body :global(p) {
		margin: 0 0 1.15rem;
		max-width: var(--measure);
		text-wrap: pretty;
	}

	.post-body :global(p:last-child) {
		margin-bottom: 0;
	}

	.post-body :global(h2) {
		margin: 2.2rem 0 0.8rem;
		font-size: var(--text-xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
	}

	.post-body :global(h3) {
		margin: 1.8rem 0 0.6rem;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.3;
		color: var(--ink);
	}

	.post-body :global(h2) + :global(h3) {
		margin-top: 0.5rem;
	}

	.post-body :global(ul),
	.post-body :global(ol) {
		margin: 0 0 1.15rem;
		padding-left: 1.4rem;
	}

	.post-body :global(li) {
		margin: 0.35rem 0;
		text-wrap: pretty;
	}

	.post-body :global(strong) {
		color: var(--ink);
		font-weight: 700;
	}

	.post-body :global(a) {
		color: var(--tab);
		font-weight: 600;
		text-underline-offset: 0.15em;
	}

	.post-body :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.2rem 0 0.2rem 1.25rem;
		border-left: 1px solid var(--rule);
		color: var(--ink-soft);
		font-style: italic;
	}

	.post-body :global(hr) {
		border: 0;
		border-top: 1px dashed var(--rule);
		margin: 2rem 0;
	}

	.post-foot {
		margin-top: 2.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--rule) 40%, transparent);
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-bottom: 1.75rem;
	}

	.post-nav__prev,
	.post-nav__next {
		text-decoration: none;
		color: var(--ink);
		text-wrap: pretty;
		line-height: 1.3;
	}

	.post-nav__prev:hover,
	.post-nav__next:hover {
		color: var(--stamp);
	}

	.post-nav__label {
		display: block;
		margin-bottom: 0.3rem;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--tab);
	}

	.post-nav__next {
		text-align: right;
	}

	.related {
		margin-bottom: 1.75rem;
	}

	.related h2 {
		margin: 0 0 0.75rem;
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--tab);
	}

	.related ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.related li {
		padding: 0.6rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--rule) 25%, transparent);
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
	}

	.related li span {
		font-size: var(--text-xs);
		color: var(--rule);
		white-space: nowrap;
	}

	.related a {
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
		text-wrap: pretty;
	}

	.related a:hover {
		color: var(--stamp);
	}

	.post-back-link {
		display: inline-block;
		margin-top: 0.5rem;
		color: var(--tab);
		font-weight: 700;
		text-decoration: none;
	}

	.post-back-link:hover {
		color: var(--stamp);
	}
</style>
